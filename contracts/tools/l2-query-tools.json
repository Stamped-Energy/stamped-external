{
  "schema_version": "1.0.0",
  "tools": [
    {
      "name": "get_measurements",
      "description": "Read measurements for one asset and metric in a time window.",
      "path": "/v1/plants/{plant_id}/measurements",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "asset_id", "metric", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "metric": { "type": "string" },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_asset_state",
      "description": "Latest asset state, or states inside a window, for one asset.",
      "path": "/v1/plants/{plant_id}/asset-state",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "asset_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_events",
      "description": "Bounded alarms and state-change events for one asset and window.",
      "path": "/v1/plants/{plant_id}/events",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "asset_id", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "list_production_orders",
      "description": "List production orders for a plant with optional status or due window.",
      "path": "/v1/plants/{plant_id}/production-orders",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "status": { "type": "string" },
          "due_from": { "type": "string", "format": "date-time" },
          "due_to": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_production_records",
      "description": "Good quantity in a window for a line or order.",
      "path": "/v1/plants/{plant_id}/production-records",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "line_id": { "type": "string" },
          "order_id": { "type": "string" },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_process_batch",
      "description": "Latest or as_of process batch for one batch or asset.",
      "path": "/v1/plants/{plant_id}/process-batches",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "batch_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_flow_position",
      "description": "One handoff, or positions that touch one asset.",
      "path": "/v1/plants/{plant_id}/flow-positions",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "position_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_maintenance_context",
      "description": "Open or planned maintenance work for one asset.",
      "path": "/v1/plants/{plant_id}/maintenance-context",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "asset_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_quality_status",
      "description": "Hold or clear for one order, batch, or asset.",
      "path": "/v1/plants/{plant_id}/quality-status",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "subject_type", "subject_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "subject_type": { "type": "string", "enum": ["order", "batch", "asset"] },
          "subject_id": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_material_availability",
      "description": "On-hand and reserved quantity for one sku at one location.",
      "path": "/v1/plants/{plant_id}/material-availability",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "sku", "location_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "sku": { "type": "string" },
          "location_id": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_shift_roster",
      "description": "Who holds a role in a time window.",
      "path": "/v1/plants/{plant_id}/shift-roster",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_operating_rate",
      "description": "Named operating rate valid at a time. Not a computed saving.",
      "path": "/v1/plants/{plant_id}/operating-rates",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "rate_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "rate_id": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "get_bill_lines",
      "description": "Bill lines for one bill.",
      "path": "/v1/plants/{plant_id}/bills/{bill_id}/lines",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id", "bill_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "bill_id": { "type": "string" }
        }
      }
    },
    {
      "name": "list_bills",
      "description": "List bills for a plant.",
      "path": "/v1/plants/{plant_id}/bills",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" }
        }
      }
    },
    {
      "name": "get_active_tariff",
      "description": "Active tariff version for a plant at a time.",
      "path": "/v1/plants/{plant_id}/tariff",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "name": "list_constraints",
      "description": "Read-only plant constraint registry.",
      "path": "/v1/plants/{plant_id}/constraints",
      "method": "GET",
      "arguments": {
        "type": "object",
        "required": ["plant_id"],
        "additionalProperties": false,
        "properties": {
          "plant_id": { "type": "string" }
        }
      }
    }
  ]
}
