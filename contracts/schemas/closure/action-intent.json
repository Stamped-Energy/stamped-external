{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/action-intent.v1.json",
  "title": "ActionIntent",
  "description": "L5 human-guided OT command intent (ADR-029). Semantic commands only — never raw register writes. Edge executes allowlisted command tags.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_intent_id",
    "org_id",
    "plant_id",
    "prescription_id",
    "asset_id",
    "command",
    "status",
    "requested_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "action_intent_id": { "type": "string", "minLength": 1 },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "prescription_id": { "type": "string", "minLength": 1 },
    "asset_id": { "type": "string", "minLength": 1 },
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "Catalog command id e.g. STOP_IDLE_AUX, SET_TEMPERATURE, APPLY_STAGGER"
    },
    "params": {
      "type": "object",
      "description": "Command parameters validated against machine-capability ranges",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "queued",
        "dispatched",
        "acked",
        "verified",
        "failed",
        "rejected"
      ]
    },
    "requested_by": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "capability_ref": {
      "type": "string",
      "description": "Id of machine-capability / allowlist entry used"
    },
    "allowlist_version": { "type": "string" },
    "edge_dispatch_id": { "type": "string" },
    "ack_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "verify_finding_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failure_reason": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
