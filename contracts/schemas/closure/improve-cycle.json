{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/improve-cycle.v1.json",
  "title": "ImproveCycle",
  "description": "Weekly human-gated Improve cycle per plant (ADR-025). Job writes draft only; staff approve/reject in L5 Internal Console.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "org_id",
    "plant_id",
    "period_start",
    "period_end",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "id": { "type": "string", "minLength": 1 },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "approved", "rejected", "partial"]
    },
    "track_a_draft": { "$ref": "#/$defs/calibrationPatchRef" },
    "track_b_profile_version": { "type": "integer", "minimum": 1 },
    "signal_summary": {
      "type": "object",
      "properties": {
        "signal_count": { "type": "integer", "minimum": 0 },
        "followed": { "type": "integer", "minimum": 0 },
        "ignored": { "type": "integer", "minimum": 0 },
        "median_time_to_outcome_hours": { "type": "number", "minimum": 0 },
        "predicted_realised_ratio": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "review_notes": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "calibrationPatchRef": {
      "type": "object",
      "properties": {
        "patch_id": { "type": "string" },
        "approval_status": { "type": "string", "enum": ["draft", "approved", "rejected"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
