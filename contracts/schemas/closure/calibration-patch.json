{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/calibration-patch.v1.json",
  "title": "CalibrationPatch",
  "description": "Track A ML calibration draft from Improve job; human-approved before L3 apply (ADR-025/027).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "org_id",
    "plant_id",
    "approval",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "id": { "type": "string", "minLength": 1 },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "improve_cycle_id": { "type": "string" },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["draft", "approved", "rejected"] },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "shrinkage_multipliers": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 2 }
    },
    "threshold_adjustments": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "model_run_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
