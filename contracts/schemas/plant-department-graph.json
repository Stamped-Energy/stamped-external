{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/plant-department-graph.v1.json",
  "title": "PlantDepartmentGraph",
  "description": "Minimal plant → department → line → asset topology + incentive weights for TradeoffEngine (ADR-024). Configured once per plant.",
  "type": "object",
  "required": [
    "schema_version",
    "org_id",
    "plant_id",
    "departments",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "departments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["department_id", "label", "lines"],
        "properties": {
          "department_id": {
            "type": "string",
            "description": "e.g. body_shop, paint, assembly, utilities"
          },
          "label": { "type": "string" },
          "supervisor_role": { "type": "string" },
          "shift_pattern": { "type": "string" },
          "incentive_weight": {
            "type": "object",
            "properties": {
              "throughput": { "type": "number", "minimum": 0, "maximum": 1 },
              "energy": { "type": "number", "minimum": 0, "maximum": 1 },
              "quality": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          },
          "critical_assets": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Cannot stagger without explicit override"
          },
          "upstream_department_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "downstream_department_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line_id"],
              "properties": {
                "line_id": { "type": "string" },
                "label": { "type": "string" },
                "asset_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
