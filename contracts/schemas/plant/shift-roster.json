{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/shift-roster.v1.json",
  "title": "ShiftRoster",
  "description": "Optional named people on shift (ADR-028). If absent, Rx must use owner_resolution=role_only — never invent a name.",
  "type": "object",
  "required": [
    "schema_version",
    "org_id",
    "plant_id",
    "shift_id",
    "window",
    "assignments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "shift_id": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "required": ["start_utc", "end_utc"],
      "properties": {
        "start_utc": { "type": "string", "format": "date-time" },
        "end_utc": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "department_id"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "department_id": { "type": "string", "minLength": 1 },
          "person_id": { "type": "string" },
          "display_name": { "type": "string" },
          "asset_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
