{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/process-batch.v1.json",
  "title": "ProcessBatch",
  "description": "One thermal or chemical charge (furnace, anodize, rack fill).",
  "type": "object",
  "required": [
    "schema_version",
    "org_id",
    "plant_id",
    "batch_id",
    "asset_id",
    "observed_at",
    "status",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "org_id": {
      "type": "string",
      "minLength": 1
    },
    "plant_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_code": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "charge_qty": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "fill_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "target_temp_c": {
      "type": "number"
    },
    "window": {
      "type": "object",
      "required": [
        "start_utc",
        "end_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "charging",
        "running",
        "soak",
        "complete",
        "held"
      ]
    },
    "order_id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "object",
      "required": [
        "source_system",
        "connector_id",
        "pack_id",
        "pack_version",
        "source_record_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "connector_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_version": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
