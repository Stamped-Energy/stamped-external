{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/maintenance-context.v1.json",
  "title": "MaintenanceContext",
  "description": "Read-only maintenance work context. Stamped does not authorize or close work orders.",
  "type": "object",
  "required": [
    "schema_version",
    "org_id",
    "plant_id",
    "work_id",
    "asset_id",
    "status",
    "blocks_production",
    "observed_at",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "org_id": {
      "type": "string",
      "minLength": 1
    },
    "plant_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "required": [
        "start_utc",
        "end_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "open",
        "in_progress",
        "done",
        "cancelled"
      ]
    },
    "blocks_production": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "object",
      "required": [
        "source_system",
        "connector_id",
        "pack_id",
        "pack_version",
        "source_record_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "connector_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_version": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
