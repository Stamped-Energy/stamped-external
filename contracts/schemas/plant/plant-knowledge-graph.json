{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/plant-knowledge-graph.v1.json",
  "title": "PlantKnowledgeGraph",
  "description": "Canonical Graph A snapshot (ADR-028). Slow plant knowledge: topology, owners, isolation, playbooks, typical envelopes. Not live telemetry.",
  "type": "object",
  "required": [
    "schema_version",
    "org_id",
    "plant_id",
    "vertical",
    "updated_at",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "vertical": {
      "type": "string",
      "enum": ["generic", "steel", "cement", "pharma", "packaging"]
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "Plant",
              "Department",
              "Line",
              "Asset",
              "AssetClass",
              "Role",
              "Person",
              "Constraint",
              "Playbook",
              "TypicalEnvelope",
              "Vertical"
            ]
          },
          "label": { "type": "string" },
          "properties": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "type", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "CONTAINS",
              "INSTANCE_OF",
              "OWNED_BY",
              "STANDBY_FOR",
              "FEEDS",
              "SERVED_BY",
              "CONSTRAINED_BY",
              "REMEDY_IN",
              "IN_VERTICAL",
              "CRITICAL_NO_STAGGER"
            ]
          },
          "to": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
