{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/operating-rate.v1.json",
  "title": "OperatingRate",
  "description": "Named commercial input (overtime per hour, furnace fuel per hour). Not a saving.",
  "type": "object",
  "required": [
    "schema_version",
    "org_id",
    "plant_id",
    "rate_id",
    "name",
    "amount",
    "currency",
    "per_unit",
    "valid_from",
    "observed_at",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "org_id": {
      "type": "string",
      "minLength": 1
    },
    "plant_id": {
      "type": "string",
      "minLength": 1
    },
    "rate_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "per_unit": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "object",
      "required": [
        "source_system",
        "connector_id",
        "pack_id",
        "pack_version",
        "source_record_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "connector_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_version": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
