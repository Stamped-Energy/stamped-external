{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/asset-state.v1.json",
  "title": "AssetState",
  "description": "Classified state of a machine or cell. Emitted on change plus 60s heartbeat.",
  "type": "object",
  "required": [
    "schema_version",
    "org_id",
    "plant_id",
    "asset_id",
    "ts_utc",
    "state",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "org_id": {
      "type": "string",
      "minLength": 1
    },
    "plant_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "ts_utc": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "running",
        "idle",
        "waiting",
        "blocked",
        "starved",
        "alarmed",
        "setup",
        "down"
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "lineage": {
      "type": "object",
      "required": [
        "source_system",
        "connector_id",
        "pack_id",
        "pack_version",
        "source_record_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "connector_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_version": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
