{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/prescription.v1.json",
  "title": "Prescription",
  "description": "L4 → L5 actionable prescription intake. status here is intake/lifecycle at handoff — L5 runtime closure states (verified, disputed, …) live on WorkflowEvent/WorkflowState (ADR-019). Optional decision_class + tradeoff for holistic management Rx (ADR-024). See technical/layers/L5-closure-and-verification.md §2–3.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "org_id",
    "plant_id",
    "status",
    "priority",
    "what",
    "why",
    "who",
    "effort",
    "when",
    "impact",
    "waste_category",
    "finding_refs",
    "evidence_refs",
    "mv_plan",
    "dedupe_key"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "id": { "type": "string", "minLength": 1 },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["open", "in_progress", "done", "deferred", "rejected", "blocked_incomplete"],
      "description": "Intake / L4-visible lifecycle only. Do not add verified|disputed here — those are L5 WorkflowState values."
    },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
    "what": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "minLength": 1 },
    "who": { "type": "string", "minLength": 1 },
    "effort": { "type": "string", "minLength": 1 },
    "when": { "type": "string", "minLength": 1 },
    "template_id": {
      "type": "string",
      "description": "Approved action template ID when template-fast-path used"
    },
    "impact": {
      "type": "object",
      "required": ["inr_monthly", "kwh_monthly", "tco2e_monthly", "confidence_interval"],
      "properties": {
        "inr_monthly": { "type": "number", "minimum": 0 },
        "kwh_monthly": { "type": "number", "minimum": 0 },
        "tco2e_monthly": { "type": "number", "minimum": 0 },
        "confidence_interval": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "waste_category": { "type": "integer", "minimum": 1, "maximum": 6 },
    "decision_class": {
      "type": "string",
      "enum": [
        "maint",
        "mgmt_schedule",
        "mgmt_capacity",
        "mgmt_cross_dept"
      ],
      "description": "ADR-024 — management classes require tradeoff when order context applies"
    },
    "tradeoff": {
      "type": "object",
      "description": "Deterministic energy vs throughput/order trade-off (L3 TradeoffEngine)",
      "properties": {
        "energy_benefit_inr_monthly": { "type": "number", "minimum": 0 },
        "throughput_risk": { "type": "string" },
        "oee_impact": { "type": "string" },
        "recommended_window": { "type": "string" },
        "alternatives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "department_owners": {
          "type": "array",
          "items": { "type": "string" }
        },
        "order_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "order_context": {
          "type": "string",
          "enum": ["known", "unknown", "partial"]
        }
      },
      "additionalProperties": false
    },
    "supersedes_rx_id": {
      "type": "string",
      "description": "Set when this Rx is an accepted negotiation revision"
    },
    "finding_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "sustainability_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mv_plan": {
      "type": "object",
      "required": ["method", "baseline_id", "verification_window"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["option_a", "option_b", "option_c", "option_d"]
        },
        "baseline_id": { "type": "string" },
        "measurement_boundary": { "type": "string" },
        "verification_window": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "agent_version": { "type": "string" },
        "prompt_version": { "type": "string" },
        "lane": {
          "type": "string",
          "enum": ["template_fast_path", "langgraph", "quality"]
        },
        "rule_versions": { "type": "array", "items": { "type": "string" } },
        "model_versions": { "type": "array", "items": { "type": "string" } },
        "compile_trace_id": {
          "type": "string",
          "description": "ADR-028 — id of l4-compile-trace snapshot stored at L5"
        },
        "otel_trace_id": {
          "type": "string",
          "description": "Optional Phoenix / OTel deep link"
        },
        "pipeline_run_id": {
          "type": "string",
          "description": "ADR-029 — optional manual perception pipeline correlation"
        }
      },
      "additionalProperties": false
    },
    "execution_mode": {
      "type": "string",
      "enum": ["execute", "monitor", "no_rx"],
      "description": "ADR-029 / Finding 1.2.0 branch — L4 emit handoff field (L5 may gate)"
    },
    "inr_trust": {
      "type": "string",
      "enum": ["l2", "fallback", "untrusted"],
      "description": "Bill-line trust for customer ₹ presentation; separate from credibility band"
    },
    "inr_label": {
      "type": "string",
      "description": "Optional human label when inr_trust=fallback"
    },
    "ops_clearance": {
      "type": "object",
      "description": "Pass-through from Finding ops_clearance for L5 verification (ADR-020)",
      "required": [
        "measurement_boundary",
        "related_tag_ids",
        "clearance_predicate",
        "expected_post_fix_signal",
        "stabilize_window",
        "reopen_if_regresses"
      ],
      "properties": {
        "measurement_boundary": { "type": "string", "minLength": 1 },
        "related_tag_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "clearance_predicate": {
          "type": "object",
          "required": ["metric", "comparator"],
          "properties": {
            "metric": { "type": "string" },
            "comparator": {
              "type": "string",
              "enum": ["lt", "lte", "gt", "gte", "eq", "in_band", "out_of_band"]
            },
            "threshold": { "type": "number" },
            "band_ref": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "relative_to": {
              "type": "string",
              "enum": ["baseline", "actual_at_detect", "absolute"]
            }
          },
          "additionalProperties": false
        },
        "expected_post_fix_signal": { "type": "string", "minLength": 1 },
        "stabilize_window": { "type": "string", "minLength": 1 },
        "reopen_if_regresses": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "predicate": {
              "type": "object",
              "required": ["metric", "comparator"],
              "properties": {
                "metric": { "type": "string" },
                "comparator": {
                  "type": "string",
                  "enum": ["lt", "lte", "gt", "gte", "eq", "in_band", "out_of_band"]
                },
                "threshold": { "type": "number" },
                "band_ref": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "relative_to": {
                  "type": "string",
                  "enum": ["baseline", "actual_at_detect", "absolute"]
                }
              },
              "additionalProperties": false
            },
            "grace_window": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "first_recommended_at": { "type": "string", "format": "date-time" },
    "implemented_at": { "type": ["string", "null"], "format": "date-time" },
    "verified_at": { "type": ["string", "null"], "format": "date-time" },
    "dedupe_key": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
