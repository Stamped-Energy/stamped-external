{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/finding.v2.json",
  "title": "Finding",
  "description": "L3 to L4 finding floor 2.0.0. Rupees only through a calculator reference. Finding 1.2.0 stays in finding.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "org_id",
    "plant_id",
    "detector_id",
    "detector_version",
    "decision_family_id",
    "domain",
    "condition_key",
    "assets",
    "facts",
    "effects",
    "verification_plan",
    "constraint_refs_considered",
    "lane",
    "dedupe_key"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "finding_id": { "type": "string", "minLength": 1 },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "detector_id": { "type": "string", "minLength": 1 },
    "detector_version": { "type": "string", "minLength": 1 },
    "decision_family_id": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "string",
      "enum": ["energy", "cost", "time", "continuity", "exception"]
    },
    "condition_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "tier", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "tier": { "type": "string", "enum": ["measured", "confirmed", "modeled", "unknown"] },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method_id", "tier", "unit"],
        "properties": {
          "method_id": { "type": "string", "minLength": 1 },
          "tier": { "type": "string", "enum": ["measured", "confirmed", "modeled", "unknown"] },
          "unit": { "type": "string", "minLength": 1 },
          "quantity": { "type": ["number", "null"] },
          "calculator_ref": { "type": ["string", "null"] }
        }
      }
    },
    "verification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "signals", "horizon", "expect"],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "insufficient"] },
        "signals": { "type": "array", "items": { "type": "string" } },
        "horizon": { "type": "string" },
        "expect": { "type": "string" }
      }
    },
    "constraint_refs_considered": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lane": { "type": "string", "enum": ["l4", "shadow"] },
    "dedupe_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
