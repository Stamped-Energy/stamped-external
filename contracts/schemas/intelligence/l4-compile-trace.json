{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/l4-compile-trace.v1.json",
  "title": "L4CompileTrace",
  "description": "Per-Rx compile snapshot L4 emits and L5 stores for internal-console tabs (ADR-028). Replayable: includes plant knowledge graph + live index snapshot stamps (legacy Graph A/B field aliases dual-written in 1.1.0). Do not stuff into prescription.provenance. Never send to L6.",
  "type": "object",
  "required": [
    "schema_version",
    "compile_trace_id",
    "prescription_id",
    "org_id",
    "plant_id",
    "lane",
    "generation_calls",
    "max_generation_calls",
    "terminal",
    "delta_facts",
    "retrieval_run",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "enum": ["1.0.0", "1.1.0"],
      "description": "1.1.0 adds descriptive field aliases alongside legacy path_*/graph_* keys"
    },
    "compile_trace_id": { "type": "string", "minLength": 1 },
    "prescription_id": {
      "type": ["string", "null"],
      "description": "Set on emit; null on withhold/abstain"
    },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "lane": {
      "type": "string",
      "enum": ["quality", "template_fast_path"]
    },
    "finding_id": { "type": "string" },
    "pipeline_run_id": { "type": "string" },
    "template_id": { "type": "string" },
    "otel_trace_id": { "type": "string" },
    "phoenix_url": { "type": "string" },
    "generation_calls": { "type": "integer", "minimum": 0 },
    "max_generation_calls": {
      "type": "integer",
      "minimum": 1,
      "description": "Hard stop for draft/repair loop. ≥10 allowed; not unbounded."
    },
    "corpus_expansions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Playbook corpus expansion count (descriptive)"
    },
    "path_h_expansions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Legacy alias for corpus_expansions"
    },
    "terminal": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["emit", "withhold", "abstain"]
        },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "owner_resolution": {
      "type": "string",
      "enum": ["named", "role_only"]
    },
    "bind": {
      "type": "object",
      "description": "Tenant-scoped entity bind result",
      "properties": {
        "asset_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["ok", "ambiguous", "missing"]
        },
        "candidates": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "snapshots": {
      "type": "object",
      "description": "Descriptive stamps preferred; legacy graph_a_*/graph_b_* dual-written for one version",
      "required": ["graph_a_updated_at", "graph_b_as_of"],
      "properties": {
        "plant_knowledge_graph_updated_at": { "type": "string", "format": "date-time" },
        "plant_live_index_as_of": { "type": "string", "format": "date-time" },
        "graph_a_updated_at": { "type": "string", "format": "date-time" },
        "graph_b_as_of": { "type": "string", "format": "date-time" },
        "order_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "neighborhood": {
      "type": "object",
      "description": "Plant knowledge-graph edges + live-index stamps used for this Rx only",
      "properties": {
        "node_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "type", "to"],
            "properties": {
              "from": { "type": "string" },
              "type": { "type": "string" },
              "to": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "live_stamps": { "type": "object" }
      },
      "additionalProperties": false
    },
    "delta_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["need", "blocker", "feasible", "who", "not"]
          },
          "text": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "retrieval_run": {
      "type": "object",
      "description": "Descriptive playbook_chunk_ids / neighborhood_hops preferred; path_h_* / path_g_* dual-written",
      "required": ["path_h_chunk_ids"],
      "properties": {
        "playbook_chunk_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "path_h_chunk_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "neighborhood_hops": { "type": "integer", "minimum": 0 },
        "path_g_hops": { "type": "integer", "minimum": 0 },
        "filters": { "type": "object" },
        "trust_tiers": {
          "type": "array",
          "items": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] }
        },
        "expansions": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    },
    "compile_loop": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "status"],
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "bind",
              "freshness",
              "neighborhood",
              "delta_facts",
              "playbook_corpus",
              "retrieve_more",
              "draft",
              "verify",
              "veto",
              "judge",
              "repair"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["ok", "fail", "skipped"]
          },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "judge": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "scores": {
          "type": "object",
          "properties": {
            "concrete_action": { "type": "number" },
            "feasible_window": { "type": "number" },
            "owner": { "type": "number" },
            "industry_specificity": { "type": "number" }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "credibility": { "type": "object" },
    "generation_attempts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "draft": { "type": "object" }
  },
  "additionalProperties": false
}
