{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stamped.energy/schemas/l4-compile-trace.v1.json",
  "title": "L4CompileTrace",
  "description": "Per-compile-attempt snapshot L4 emits and L5 stores for internal-console tabs (ADR-028/029). Replayable: Graph A/B snapshot stamps. Do not stuff into prescription.provenance. Never send to L6. prescription_id required only when terminal.status=emit.",
  "type": "object",
  "required": [
    "schema_version",
    "compile_trace_id",
    "org_id",
    "plant_id",
    "lane",
    "generation_calls",
    "max_generation_calls",
    "terminal",
    "delta_facts",
    "retrieval_run",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.1.0"
    },
    "compile_trace_id": { "type": "string", "minLength": 1 },
    "prescription_id": {
      "type": ["string", "null"],
      "description": "Required when terminal.status=emit; null/omitted for withhold|abstain"
    },
    "pipeline_run_id": {
      "type": "string",
      "description": "ADR-029 — L5 manual perception pipeline run correlation id"
    },
    "finding_id": { "type": "string" },
    "org_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "lane": {
      "type": "string",
      "enum": ["quality", "template_fast_path"]
    },
    "template_id": { "type": "string" },
    "otel_trace_id": { "type": "string" },
    "phoenix_url": { "type": "string" },
    "generation_calls": { "type": "integer", "minimum": 0 },
    "max_generation_calls": {
      "type": "integer",
      "minimum": 1,
      "description": "Hard stop for draft/repair loop. Default 12; not unbounded."
    },
    "path_h_expansions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Count of retrieve_more Path H expansions this attempt"
    },
    "terminal": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["emit", "withhold", "abstain"]
        },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "owner_resolution": {
      "type": "string",
      "enum": ["named", "role_only"]
    },
    "bind": {
      "type": "object",
      "description": "Tenant-scoped entity bind result",
      "properties": {
        "asset_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["ok", "ambiguous", "missing"]
        },
        "candidates": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "snapshots": {
      "type": "object",
      "required": ["graph_a_updated_at", "graph_b_as_of"],
      "properties": {
        "graph_a_updated_at": { "type": "string", "format": "date-time" },
        "graph_b_as_of": { "type": "string", "format": "date-time" },
        "order_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "neighborhood": {
      "type": "object",
      "description": "Graph A edges + Graph B stamps used for this attempt only",
      "properties": {
        "node_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "type", "to"],
            "properties": {
              "from": { "type": "string" },
              "type": { "type": "string" },
              "to": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "live_stamps": { "type": "object" }
      },
      "additionalProperties": false
    },
    "delta_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["need", "blocker", "feasible", "who", "not"]
          },
          "text": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "retrieval_run": {
      "type": "object",
      "required": ["path_h_chunk_ids"],
      "properties": {
        "path_h_chunk_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "path_g_hops": { "type": "integer", "minimum": 0 },
        "filters": { "type": "object" },
        "trust_tiers": {
          "type": "array",
          "items": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] }
        },
        "expansions": {
          "type": "array",
          "description": "retrieve_more expansion queries (structured, no CoT)",
          "items": {
            "type": "object",
            "required": ["query", "chunk_ids"],
            "properties": {
              "query": { "type": "string" },
              "chunk_ids": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compile_loop": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "status"],
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "bind",
              "freshness",
              "path_g",
              "path_d",
              "path_h",
              "draft",
              "verify",
              "veto",
              "judge",
              "repair",
              "retrieve_more"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["ok", "fail", "skipped"]
          },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "judge": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "action": {
          "type": "string",
          "enum": ["pass", "rewrite", "retrieve_more", "abstain"],
          "description": "ADR-029 typed reflection action"
        },
        "scores": {
          "type": "object",
          "properties": {
            "concrete_action": { "type": "number" },
            "feasible_window": { "type": "number" },
            "owner": { "type": "number" },
            "industry_specificity": { "type": "number" }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "credibility": {
      "type": "object",
      "description": "Staff-facing operational credibility (ADR-029). Not a statistical probability.",
      "required": ["band", "score_0_100"],
      "properties": {
        "band": {
          "type": "string",
          "enum": ["high", "medium", "low", "insufficient"]
        },
        "score_0_100": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "components": {
          "type": "object",
          "properties": {
            "finding_confidence": { "type": "number" },
            "bind_quality": { "type": "number" },
            "freshness": { "type": "number" },
            "evidence_coverage": { "type": "number" },
            "path_h_trust": { "type": "number" },
            "verify_veto": { "type": "number" },
            "practicality": { "type": "number" }
          },
          "additionalProperties": false
        },
        "forced_insufficient_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generation_attempts": {
      "type": "array",
      "description": "Structured draft/judge/repair iterations (no chain-of-thought)",
      "items": {
        "type": "object",
        "required": ["call_index", "task_class"],
        "properties": {
          "call_index": { "type": "integer", "minimum": 0 },
          "task_class": {
            "type": "string",
            "enum": ["draft", "judge", "repair", "retrieve_more"]
          },
          "prompt_version": { "type": "string" },
          "prompt_prefix_hash": {
            "type": "string",
            "description": "sha256 of byte-stable prefix for cache regression"
          },
          "tool_schema_version": { "type": "string" },
          "model_provider": { "type": "string" },
          "model_name": { "type": "string" },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": { "type": "integer", "minimum": 0 },
              "cached_input_tokens": { "type": "integer", "minimum": 0 },
              "uncached_input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 },
              "cache_hit_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
              "estimated_cost_usd": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "draft_snapshot": {
            "type": "object",
            "description": "Structured What/Why/Who/When/Effort snapshot only",
            "properties": {
              "what": { "type": "string" },
              "why": { "type": "string" },
              "who": { "type": "string" },
              "when": { "type": "string" },
              "effort": { "type": "string" }
            },
            "additionalProperties": false
          },
          "judge_feedback": {
            "type": "string",
            "description": "Structured failure reasons for repair; not free CoT"
          }
        },
        "additionalProperties": false
      }
    },
    "draft": {
      "type": "object",
      "description": "Final structured draft language (emit or last attempt)",
      "properties": {
        "what": { "type": "string" },
        "why": { "type": "string" },
        "who": { "type": "string" },
        "when": { "type": "string" },
        "effort": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal": {
            "properties": { "status": { "const": "emit" } },
            "required": ["status"]
          }
        },
        "required": ["terminal"]
      },
      "then": {
        "required": ["prescription_id"],
        "properties": {
          "prescription_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
